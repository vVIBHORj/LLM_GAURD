# LocalLLM Guard Environment Variables Template
APP_NAME=LocalLLM Guard
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

DATABASE_URL=sqlite:///./data/localllm_guard.db

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120.0

MIN_FREE_RAM_MB=1500
MAX_VRAM_USAGE_PERCENT=90.0
DEFAULT_CONTEXT_LENGTH=2048
DEFAULT_INFERENCE_CONCURRENCY=1
COOL_DOWN_SECONDS=2.0

PROMPTFOO_BINARY=promptfoo
PROMPTFOO_TIMEOUT_SECONDS=300
PROMPTFOO_CONFIG_DIR=./data/configs
PROMPTFOO_RUNS_DIR=./data/runs
